@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Student" as Student
actor "Admin" as Admin
actor "Peer Tester / Faculty Evaluator" as Evaluator
actor "LLM API (optional)" as LLM
database "PostgreSQL Database" as DB

rectangle "NeuroTask Platform" {
  package "Student Functions" {
    usecase "Register / Log in" as UC1
    usecase "Manage Personal Account" as UC2
    usecase "Create / Manage Assignment" as UC3
    usecase "Generate 10–15 min Micro-actions" as UC4
    usecase "Manage Prerequisite Dependencies" as UC5
    usecase "Use Focus Workspace and Timer" as UC6
    usecase "Complete Micro-action" as UC7
    usecase "Use I'm Stuck Rescue" as UC8
    usecase "Record Energy and Distractions" as UC9
    usecase "View Personal Insights" as UC10
    usecase "Browse / Use Blueprints" as UC11
  }

  package "Admin Functions" {
    usecase "Access Admin Dashboard" as UC12
    usecase "Search and View Basic User Details" as UC13
    usecase "Activate / Deactivate Accounts" as UC14
    usecase "Monitor Aggregate Application Metrics" as UC15
    usecase "View System Status and Errors" as UC16
    usecase "Manage Blueprint Library" as UC17
    usecase "Review Admin Audit Logs" as UC18
  }

  usecase "Record Administrative Action" as UC19
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC6
Student --> UC7
Student --> UC8
Student --> UC9
Student --> UC10
Student --> UC11

UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC8 .> UC4 : <<extend>>
UC6 .> UC9 : <<include>>

Admin --> UC1
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18

UC14 .> UC19 : <<include>>
UC17 .> UC19 : <<include>>

UC4 --> LLM : optional generation
UC1 --> DB
UC3 --> DB
UC4 --> DB
UC6 --> DB
UC9 --> DB
UC10 --> DB
UC11 --> DB
UC13 --> DB
UC14 --> DB
UC15 --> DB
UC17 --> DB
UC18 --> DB

Evaluator --> UC1
note right of UC15
  Aggregate monitoring only.
  No automatic access to private
  assignment descriptions or
  individual telemetry records.
end note
@enduml
